# ==============================================================================
# EduGrade AI — Environment Variables Template
# Copy this file to '.env' and update the values as needed for your environment.
# ==============================================================================

# Core Django Security Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Administrative Access Key (Leave empty to disable admin/faculty signup)
ADMIN_SIGNUP_KEY=your_admin_signup_key_here

# External AI Advisor Integration (Optional - Get a key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=15
OPENAI_API_KEY=your_openai_api_key_here
